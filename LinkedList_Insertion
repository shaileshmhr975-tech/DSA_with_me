struct Node {
    int data;
    struct Node *next;
};

void Traversal(struct Node *head, struct Node *temp) {
    temp = head;
    while(temp != NULL) {
        
        printf("%d\n",temp->data);
        temp = temp->next;
    }
    

};
// Insertion at Begining
struct Node *insertAtFirst(struct Node *head) {
    struct Node *ptr = (struct Node *)malloc(sizeof(struct Node));
    ptr->next = head;
    ptr->data = 57;
    return ptr;
}
// Insertion in between
struct Node *insertAtIndex(struct Node *head, int index) {
    struct Node *ptr = (struct Node *)malloc(sizeof(struct Node));
    struct Node *p = head;
    int i = 0;
    while(i != index - 1) {
        p = p->next;
        i++;
    }
    ptr->data = 56;
    ptr->next = p->next;
    p->next = ptr;
    return head;

}

